# Database Configuration
# Supports both PostgreSQL (with RLS) and SQLite (for quick offline dev)
DATABASE_URL=sqlite+aiosqlite:///./fitflow.db
# Example for PostgreSQL / Supabase:
# DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/fitflow
# DATABASE_URL=postgresql+asyncpg://postgres.yourproject:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# JWT Security
JWT_SECRET=supersecret_fitflow_jwt_key_hackathon_demo_2026_change_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Environment
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase (Optional)
SUPABASE_URL=
SUPABASE_KEY=
